# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next.old.*/
/out/
/out.old/
/out.root.*/

# production
/build
/_site/

# headless chrome (puppeteer local install)
/chrome-headless-shell/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# deploy script logs
/deploy.log
/deploy-*.log

# Claude Code local settings
/.claude/

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# sanity studio
.sanity/
/dist/
webhook/logs/

# supabase local (contains project ref, org ID, pooler hostname)
supabase/.temp/

# screenshots
/temp_ss/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
