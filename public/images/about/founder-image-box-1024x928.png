    "https://www.linkedin.com/company/admizzofficial/"
  ],
  "description": "Admizz Education is a leading study abroad consultancy helping students from Nepal pursue higher education in the USA, UK, Canada, and Australia. We provide expert counselling, admission support, test preparation, and visa guidance through our offices in Kathmandu and Birgunj.",
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+977-01-5328444",
    "contactType": "customer support",
    "email": "support@admizz.com",
    "areaServed": "NP",
    "availableLanguage": ["English", "Nepali"]
  },
  "department": [
    {
      "@type": "EducationalOrganization",
      "name": "Admizz Education - Kathmandu",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "4th Floor, Sita Ram Square, Putalisadak",
        "addressLocality": "Kathmandu",
        "addressRegion": "Bagmati Province",
        "postalCode": "44600",
        "addressCountry": "NP"
      },
      "telephone": "+977-01-5328444",
      "email": "support@admizz.com",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "27.7172",
        "longitude": "85.3240"
      },
      "areaServed": "Kathmandu, Nepal"
    },
    {
      "@type": "EducationalOrganization",
      "name": "Admizz Education - Birgunj",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "3rd Floor, Link Road, Birgunj, Parsa",
        "addressLocality": "Birgunj",
        "addressRegion": "Province 2",
        "postalCode": "44300",
        "addressCountry": "NP"
      },
      "telephone": "+977-051-592226",
      "email": "support@admizz.com",
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "27.0042",
        "longitude": "84.8672"
      },
      "areaServed": "Birgunj, Nepal"
    }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Study Abroad Services in Nepal",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Study Abroad Counselling",
          "description": "Professional study abroad counselling for Nepali students seeking higher education in the USA, UK, Canada, and Australia."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "University Admission Support",
          "description": "Assistance with university shortlisting, application processing, SOP/LOR guidance, and admission documentation."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Visa Guidance",
          "description": "Comprehensive student visa counselling and documentation support for global destinations."
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Test Preparation",
          "description": "IELTS, TOEFL, GRE, and GMAT test preparation courses for Nepali students planning to study abroad."
        }
      }
    ]
  }
}
</script>
