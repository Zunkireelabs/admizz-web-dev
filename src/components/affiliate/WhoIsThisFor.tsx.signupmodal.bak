      {/* Refined ambient depth */}
      <div className="absolute inset-0 pointer-events-none"
        style={{ background: "radial-gradient(ellipse 80% 60% at 50% 0%, rgba(49,66,156,0.18) 0%, transparent 60%)" }} />
      <div className="absolute inset-0 pointer-events-none"
        style={{ background: "radial-gradient(ellipse 50% 40% at 50% 100%, rgba(252,183,48,0.06) 0%, transparent 60%)" }} />
      {/* Refined dot grid */}
      <div className="absolute inset-0 pointer-events-none opacity-40"
        style={{
          backgroundImage: "radial-gradient(circle, rgba(255,255,255,0.04) 1px, transparent 1px)",
          backgroundSize: "40px 40px",
        }} />
      {/* Hero seam absorber — fades hero's bright end into this section's bg */}
      <div className="absolute top-0 left-0 right-0 pointer-events-none"
        style={{ height: "180px", background: "linear-gradient(to bottom, #0c1270 0%, rgba(12,18,112,0.55) 35%, rgba(6,12,31,0) 100%)" }} />
      {/* Top gradient line — visual continuity */}
      <div className="absolute top-0 left-0 right-0 h-px"
        style={{ background: "linear-gradient(90deg, transparent, rgba(252,183,48,0.25), transparent)" }} />

      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        {/* Premium section header */}
        <motion.div className="text-center max-w-2xl mx-auto mb-16 md:mb-20" ref={ref}
          initial={{ opacity: 0, y: 24 }} animate={inView ? { opacity: 1, y: 0 } : {}}
          transition={{ duration: 0.7, ease: [0.22, 1, 0.36, 1] as const }}>
          <span
            className="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-[11px] font-bold uppercase mb-6"
            style={{
              background: "rgba(253,237,34,0.08)",
              border: "1px solid rgba(253,237,34,0.22)",
              color: "#FDED22",
              letterSpacing: "0.18em",
            }}
          >
            <span className="w-1 h-1 rounded-full" style={{ background: "#FDED22" }} />
            Who It&apos;s For
          </span>
          <h2 className="text-3xl md:text-[44px] font-extrabold text-white leading-[1.1] tracking-[-0.015em]">
            There&apos;s a Path For You
          </h2>
          <p className="mt-5 text-base md:text-[17px] leading-[1.6]" style={{ color: "rgba(255,255,255,0.55)" }}>
            Three types of people thrive in the Admizz Affiliate Program.
            Find the one that fits you.
          </p>
        </motion.div>

        <div className="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
          {PATHWAYS.map((p, i) => (
            <motion.div
              key={p.id}
              className="relative flex flex-col rounded-2xl overflow-hidden cursor-pointer group"
              style={{
                background: "rgba(255,255,255,0.025)",
                border: `1px solid ${active === p.id ? p.accentBorder : "rgba(255,255,255,0.08)"}`,
                boxShadow: active === p.id
                  ? `0 20px 60px rgba(0,0,0,0.5), 0 0 0 1px ${p.accentBorder}`
                  : "0 4px 24px rgba(0,0,0,0.25)",
                backdropFilter: "blur(20px)",
                transition: "all 0.3s ease",
              }}
              initial={reduce ? { opacity: 0 } : { opacity: 0, y: 32 }}
              animate={inView ? { opacity: 1, y: 0 } : {}}
              transition={{ duration: 0.6, delay: 0.1 + i * 0.1, ease: [0.22, 1, 0.36, 1] as const }}
              onHoverStart={() => setActive(p.id)}
              onHoverEnd={() => setActive(null)}
              whileHover={reduce ? {} : { y: -6, transition: { duration: 0.22 } }}
              onClick={() => document.getElementById("apply-form")?.scrollIntoView({ behavior: "smooth" })}
            >
              {/* Featured top accent */}
              {p.featured && (
                <div className="absolute top-0 right-0 m-5 z-20">
                  <span
                    className="px-2.5 py-1 rounded-full text-[9.5px] font-extrabold uppercase tracking-widest"
                    style={{ background: "rgba(252,183,48,0.15)", border: "1px solid rgba(252,183,48,0.35)", color: "#FCB730" }}
                  >
                    Most Popular
                  </span>
                </div>
              )}

              {/* Top accent bar */}
              <div className="h-[3px] w-full" style={{ background: p.accent }} />

              {/* Hover glow */}
              <div
                className="absolute inset-0 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500"
                style={{ background: `radial-gradient(ellipse 80% 60% at 50% 0%, ${p.accent}10 0%, transparent 70%)` }}
              />

              <div className="relative p-7 md:p-8 flex flex-col flex-1">
                {/* Eyebrow */}
                <span
                  className="inline-flex self-start px-2.5 py-1 rounded-md text-[10px] font-bold uppercase mb-7"
                  style={{
                    background: p.accentSoft,
                    border: `1px solid ${p.accentBorder}`,
                    color: p.accent,
                    letterSpacing: "0.15em",
                  }}
                >
                  {p.eyebrow}
                </span>

                {/* Icon container — premium treatment */}
                <div
                  className="w-12 h-12 rounded-xl flex items-center justify-center mb-6 transition-all duration-300 group-hover:scale-110"
                  style={{
                    background: p.accentSoft,
                    border: `1px solid ${p.accentBorder}`,
                    color: p.accent,
                  }}
                >
                  {p.icon}
                </div>

                <h3 className="text-xl md:text-[22px] font-extrabold text-white mb-1.5 tracking-tight">
                  {p.title}
                </h3>
                <p className="text-[13px] font-semibold mb-5" style={{ color: p.accent }}>
                  {p.who}
                </p>
                <p className="text-[15px] leading-[1.65] mb-7 flex-1" style={{ color: "rgba(255,255,255,0.6)" }}>
                  {p.description}
                </p>

                <ul className="space-y-3 mb-8">
                  {p.perks.map(perk => (
                    <li key={perk} className="flex items-start gap-3 text-[14px]"
                      style={{ color: "rgba(255,255,255,0.7)" }}>
                      <span
                        className="flex-shrink-0 w-4 h-4 rounded-full flex items-center justify-center mt-0.5"
                        style={{ background: p.accentSoft, color: p.accent }}
                      >
                        <svg className="w-2.5 h-2.5" fill="none" stroke="currentColor" strokeWidth={3} viewBox="0 0 24 24">
                          <path strokeLinecap="round" strokeLinejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                      </span>
                      {perk}
                    </li>
                  ))}
                </ul>

                <div
                  className="flex items-center gap-2 text-sm font-bold mt-auto pt-5 transition-all duration-200"
                  style={{ borderTop: "1px solid rgba(255,255,255,0.06)", color: p.accent }}
                >
                  {p.cta}
                  <svg className="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2.5} d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </div>
              </div>
            </motion.div>
          ))}
        </div>

        <motion.p
          className="text-center text-[14px] mt-12"
          style={{ color: "rgba(255,255,255,0.45)" }}
          initial={{ opacity: 0 }} animate={inView ? { opacity: 1 } : {}}
          transition={{ duration: 0.6, delay: 0.55 }}>
          Not sure which fits you?{" "}
          <a href="/contact" className="font-bold transition-colors duration-200 hover:text-yellow" style={{ color: "#FCB730" }}>
            Email us
          </a>
        </motion.p>
      </div>
    </section>
  );
}
