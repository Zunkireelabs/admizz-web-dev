"use client";

import { motion, useInView, useReducedMotion } from "framer-motion";
import { useRef, useState } from "react";

const PATHWAYS = [
  {
    id: "campus",
    eyebrow: "For Students",
    title: "Campus Ambassador",
    who: "TU · KU · PU · ISMT students",
    description: "You know students planning to study abroad. Represent Admizz on your campus, share your referral link, and earn every time a classmate enrolls.",
    perks: [
      "Official campus representative certificate",
      "Earn a commission per enrolled referral",
      "No follower count or experience needed",
    ],
    cta: "Sign up as Campus Ambassador",
    accent: "#31429C",
    accentSoft: "rgba(49,66,156,0.12)",
    accentBorder: "rgba(49,66,156,0.25)",
    icon: (
      <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.7} d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
      </svg>
    ),
  },
  {
    id: "creator",
    eyebrow: "For Creators",
    title: "Content Creator",
    who: "Instagram · YouTube · TikTok · Blogs",
    description: "You create content about education or student life. Add your affiliate link and earn every time a viewer becomes an Admizz student.",
    perks: [
      "No minimum follower count required",
      "Co-branded content templates provided",
      "Real-time dashboard to track clicks",
    ],
    cta: "Sign up as Content Creator",
    accent: "#FCB730",
    accentSoft: "rgba(252,183,48,0.14)",
    accentBorder: "rgba(252,183,48,0.32)",
    featured: true,
    icon: (
      <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.7} d="M15 10l4.553-2.07A1 1 0 0121 8.882V15.12a1 1 0 01-1.447.89L15 14M3 8a2 2 0 012-2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8z" />
      </svg>
    ),
  },
  {
    id: "professional",
    eyebrow: "For Professionals",
    title: "Education Professional",
    who: "Counselors · Coaches · Teachers",
    description: "You work with students daily. Refer them to Admizz and earn when they enroll. No complicated setup — just share your unique link.",
    perks: [
      "Dedicated partner support line",
      "Earn on every referral you send",
      "Works for independent counselors & tutors",
    ],
    cta: "Sign up as Professional",
    accent: "#FDED22",
    accentSoft: "rgba(253,237,34,0.12)",
    accentBorder: "rgba(253,237,34,0.3)",
    icon: (
      <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.7} d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
      </svg>
    ),
  },
];

export default function WhoIsThisFor() {
  const ref = useRef<HTMLDivElement>(null);
  const inView = useInView(ref, { once: true, margin: "-10% 0px" });
  const reduce = useReducedMotion();
