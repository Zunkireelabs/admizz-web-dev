export default function FlagStripe({
  width = 4,
  height = "100%",
  className = "",
}: {
  width?: number;
  height?: string | number;
  className?: string;
}) {
  return (
    <div
      className={className}
      style={{
        width,
        height,
        background:
          "linear-gradient(to bottom, #FF6B1A 0%, #FF6B1A 33.33%, #FFFFFF 33.33%, #FFFFFF 66.66%, #138808 66.66%, #138808 100%)",
        borderRadius: 2,
      }}
      aria-hidden="true"
    />
  );
}
