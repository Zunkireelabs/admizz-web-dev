      ],
      "markDefs": [],
      "style": "h2"
    },
    {
      "_key": "80f63d64597e",
      "_type": "block",
      "children": [
        {
          "_key": "7881cc4c8214",
          "_type": "span",
          "marks": [],
          "text": "Study Australia explains that when you apply for a Student visa, officers assess whether you meet the Genuine Student requirement. The questions can cover your current circumstances and ties to your home country, and why you chose Australia and your course. Answer from your own situation and keep your statement consistent with your documents."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "1f07c8e60c46",
      "_type": "block",
      "children": [
        {
          "_key": "97139f7c7aa4",
          "_type": "span",
          "marks": [],
          "text": "The Home Affairs Visa Prices table lists the Student visa (subclass 500) base application charge as AUD 2,500 for most students and AUD 2,050 for ELICOS and Non-Award courses, with an extra AUD 1,530 for each additional applicant aged 18 or over. Charges are reviewed each year, so check the table before you pay."
        }
      ],
      "markDefs": [],
