      "markDefs": [],
      "style": "h3"
    },
    {
      "_key": "e7e7ce0f579d",
      "_type": "block",
      "children": [
        {
          "_key": "82d6859cb6cb",
          "_type": "span",
          "marks": [],
          "text": "One of the biggest reliefs for Nepali students is the "
        },
        {
          "_key": "e277c562a4dd",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "lower financial evidence requirements"
        },
        {
          "_key": "93b27ce670c3",
          "_type": "span",
          "marks": [],
          "text": ". Compared to when Nepal was in "
        },
        {
          "_key": "ee4b8861e911",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Assessment Level 3"
        },
        {
          "_key": "3295cadb9ec6",
          "_type": "span",
          "marks": [],
          "text": ", students now need to provide less documentation to prove financial stability."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "08c97f31e3f8",
      "_type": "block",
      "children": [
        {
          "_key": "61bb6f203e4c",
          "_type": "span",
          "marks": [],
          "text": "Students applying to Level 2 universities and institutions may not need to submit extensive proof of funds."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "4226fcb906d3",
      "_type": "block",
      "children": [
        {
          "_key": "a9fa4bdc59d8",
          "_type": "span",
          "marks": [],
          "text": "This simplifies the application process and makes studying in Australia more accessible."
