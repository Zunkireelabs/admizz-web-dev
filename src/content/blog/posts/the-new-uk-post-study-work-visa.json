          "_key": "3c366c30f899",
          "_type": "span",
          "marks": [],
          "text": "Even with 18 months, you can achieve a lot — if you plan well!"
        },
        {
          "_key": "61305ccd08d6",
          "_type": "span",
          "marks": [],
          "text": "\n"
        },
        {
          "_key": "f9803137a5d9",
          "_type": "span",
          "marks": [],
          "text": "Here are "
        },
        {
          "_key": "b7fb273db35c",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Admizz Education’s top tips"
