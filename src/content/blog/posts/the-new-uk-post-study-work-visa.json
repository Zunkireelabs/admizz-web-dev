            "strong"
          ],
          "text": "What Is the UK Post-Study Work Visa (Graduate Route)?"
        }
      ],
      "markDefs": [],
      "style": "h4"
    },
    {
      "_key": "52a29dc344f3",
      "_type": "block",
      "children": [
        {
          "_key": "cedf8bc91bbf",
          "_type": "span",
          "marks": [],
          "text": "The "
        },
        {
          "_key": "a4f9dba0519a",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Graduate Route"
        },
        {
          "_key": "633fa49db139",
          "_type": "span",
          "marks": [],
          "text": " allows international students to "
        },
        {
          "_key": "f3eb95efd5bb",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "stay in the UK and work"
        },
        {
          "_key": "47d00baec2db",
          "_type": "span",
          "marks": [],
          "text": " after completing their studies. It gives students the freedom to look for jobs, gain work experience, or even start their own business — without needing a sponsorship right away."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "efc5540036a0",
      "_type": "block",
      "children": [
        {
          "_key": "e52e42881a1b",
          "_type": "span",
          "marks": [],
          "text": "For "
        },
        {
          "_key": "d9e65bcf5a71",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Nepali students"
        },
        {
          "_key": "5a62f39bae91",
          "_type": "span",
          "marks": [],
          "text": ", this is one of the biggest advantages of studying in the UK. It gives you a "
        },
        {
          "_key": "761a1eea1f3e",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "smooth transition from study to career"
        },
        {
          "_key": "929f7ebfdc31",
          "_type": "span",
          "marks": [],
          "text": ", allowing you to build your global experience and improve your future prospects."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "fc159000ef27",
      "_type": "block",
      "children": [
        {
          "_key": "c23a380f6057",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "The Major Update: Duration Reduced to 18 Months"
        }
      ],
      "markDefs": [],
      "style": "h4"
    },
    {
      "_key": "86fee28923d4",
      "_type": "block",
      "children": [
        {
          "_key": "3ff096a371c2",
          "_type": "span",
          "marks": [],
          "text": "From "
        },
        {
          "_key": "dfd679e67db9",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "1st January 2027"
        },
        {
          "_key": "c93a83cf40e9",
          "_type": "span",
          "marks": [],
          "text": ", the UK government has announced that the "
        },
        {
          "_key": "63b0122a6a68",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "post-study work duration"
        },
        {
          "_key": "34b8e539e69c",
          "_type": "span",
          "marks": [],
          "text": " for undergraduate and master’s graduates will be "
        },
        {
          "_key": "dfe6527b8579",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "reduced from 2 years to 18 months"
        },
        {
          "_key": "0fc9998fb4ef",
          "_type": "span",
          "marks": [],
          "text": "."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "ff00cd81c639",
      "_type": "block",
      "children": [
        {
          "_key": "0af1d695ec6e",
          "_type": "span",
          "marks": [],
          "text": "PhD and research students, however, will continue to get "
        },
        {
          "_key": "873d8df2f746",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "3 years"
        },
        {
          "_key": "1480f61e1cca",
          "_type": "span",
          "marks": [],
          "text": "."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "6b18a569f12a",
      "_type": "block",
      "children": [
        {
          "_key": "9a72fe203749",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "What this means for you:"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "6dc828bd5c3b",
      "_type": "block",
      "children": [
        {
          "_key": "f4a05283fd5b",
          "_type": "span",
          "marks": [],
          "text": "If you plan to study in the UK before 2027, you can still get the "
        },
        {
          "_key": "dc5852e5e647",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "full 2 years"
        },
        {
          "_key": "068bc5386255",
          "_type": "span",
          "marks": [],
          "text": "."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "18b85131d31b",
      "_type": "block",
      "children": [
        {
          "_key": "9e62b9dd1fb8",
          "_type": "span",
          "marks": [],
          "text": "If your graduation falls after 2027, your "
        },
        {
          "_key": "4770666a8420",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Graduate Route"
        },
        {
          "_key": "96ae78716ed6",
          "_type": "span",
          "marks": [],
          "text": " will be limited to "
        },
        {
          "_key": "ad2611e83c4e",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "18 months"
        },
        {
          "_key": "d2b09b028cd2",
          "_type": "span",
          "marks": [],
          "text": "."
        }
