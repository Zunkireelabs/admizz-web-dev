      "style": "normal",
      "listItem": "number",
      "level": 1
    },
    {
      "_key": "ec3a01528ac5",
      "_type": "block",
      "children": [
        {
          "_key": "fb7723ca656b",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Consider Alternative Tests"
        },
        {
          "_key": "5298b468f08f",
          "_type": "span",
          "marks": [],
          "text": "\n"
        },
        {
          "_key": "88960bfd10cf",
          "_type": "span",
          "marks": [],
          "text": "Some universities also accept TOEFL, PTE Academic, or Duolingo English Test as alternatives."
