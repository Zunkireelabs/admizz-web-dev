        {
          "_key": "b743545366ec",
          "_type": "span",
          "marks": [],
          "text": "\n"
        },
        {
          "_key": "270491200485",
          "_type": "span",
          "marks": [],
          "text": "\nIt depends on the country and intake. On average, the process from initial counseling to visa approval takes 3 to 9 months. Starting early is always advisable."
        }
