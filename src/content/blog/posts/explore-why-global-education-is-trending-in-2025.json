      "children": [
        {
          "_key": "b54af8660697",
          "_type": "span",
          "marks": [],
          "text": "The application process for study abroad can seem daunting, but with careful planning and the right guidance, it’s entirely achievable. Here are the general steps:"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
