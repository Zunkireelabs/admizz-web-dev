        {
          "_key": "528d3d9b85e4",
          "_type": "span",
          "marks": [],
          "text": " Italy (Rome, Florence), Spain (Barcelona, Madrid), Ireland (Dublin)."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
