        {
          "_key": "d96bbb78079b",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Research Programs and Destinations:"
        },
        {
          "_key": "45df6d74e9d2",
          "_type": "span",
          "marks": [],
          "text": " Explore your options based on your academic goals, interests, and budget."
        }
      ],
      "level": 1,
      "listItem": "number",
      "markDefs": [],
      "style": "normal"
    },
    {
