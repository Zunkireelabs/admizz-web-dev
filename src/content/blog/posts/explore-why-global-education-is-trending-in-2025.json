          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "For STEM & Innovation:"
        },
        {
          "_key": "6b8b3384dfdf",
          "_type": "span",
          "marks": [],
          "text": " Germany (Berlin, Munich), Netherlands, Japan (Tokyo), South Korea (Seoul)."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
