      "children": [
        {
          "_key": "aeb68301ec93",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Check Eligibility Requirements:"
        },
        {
          "_key": "7d8b53d22f57",
          "_type": "span",
          "marks": [],
          "text": " Ensure you meet the GPA, language proficiency, and other criteria for your chosen programs."
        }
      ],
