      "_type": "block",
      "children": [
        {
          "_key": "10666489cda7",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Part-time Work (where allowed):"
        },
        {
          "_key": "0fbe74d793bc",
          "_type": "span",
          "marks": [],
          "text": " Some countries allow international students to work part-time to help with living expenses."
        }
      ],
      "level": 1,
