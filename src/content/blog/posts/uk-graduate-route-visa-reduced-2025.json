        {
          "_key": "7cb466221b89",
          "_type": "span",
          "marks": [],
          "text": "The UK is aiming to welcome "
        },
        {
          "_key": "0f71b714e790",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "highly skilled and motivated international students"
        },
        {
          "_key": "0ef1db7e42d7",
          "_type": "span",
          "marks": [],
          "text": " who want to "
        },
        {
          "_key": "6e4d328a8c8c",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "study, work, and thrive"
        },
        {
          "_key": "7078eafe49a0",
          "_type": "span",
          "marks": [],
          "text": " in the country."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
