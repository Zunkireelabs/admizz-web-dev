          ],
          "text": "Admizz Education"
        },
        {
          "_key": "4f35da3568e8",
          "_type": "span",
          "marks": [],
          "text": ", we’ve helped hundreds of Nepali students successfully navigate the student visa process — from choosing the right course and institution to preparing airtight documentation and crafting powerful SOPs."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "f75846be1a6d",
      "_type": "block",
      "children": [
        {
          "_key": "d44b5042783f",
          "_type": "span",
          "marks": [],
          "text": "Our team of certified education consultants understands exactly what embassies look for, and we’re here to make sure your application gives you the best possible chance of success."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "51e46d58049f",
      "_type": "block",
      "children": [
        {
          "_key": "6e4a6be77854",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Don’t leave your future to chance."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "ab2867a337d3",
      "_type": "block",
      "children": [
