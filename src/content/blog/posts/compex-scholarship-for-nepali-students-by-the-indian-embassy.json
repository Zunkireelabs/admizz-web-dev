        {
          "_key": "32832e6ba7a1",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Nepal and India"
        },
        {
          "_key": "2e69c2da5e06",
          "_type": "span",
          "marks": [],
          "text": ". Facilitated by the "
        },
        {
          "_key": "637169a25ea1",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Embassy of India in Kathmandu"
        },
        {
          "_key": "48c7aaf962cf",
          "_type": "span",
          "marks": [],
          "text": ", this prestigious scholarship program offers aspiring Nepali students a gateway to pursue "
