      "html": "\n<style>\n\n  \n\n\n  body {\n    font-family: 'Rubik', sans-serif;\n    background: #faf8f4;\n\n    color: #1a1714;\n    line-height: 1.7;\n    font-size: 16px;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  /* ── Layout Shell ── */\n  .page-wrapper {\n    max-width: 100%;\n    margin: 0 auto;\n    padding: 0 24px 80px;\n  }\n\n \n\n  \n  \n  .rule {\n    border: none;\n    border-top: 1px solid #e8e2da;\n    margin: 36px 0;\n  }\n\n  /* ── Body Text ── */\n  .article-body p {\n    font-size: 18px;\n    line-height: 1.78;\n    color: #1a1714;\n    margin-bottom: 22px;\n    font-weight: 300;\n  }\n\n  .article-body strong {\n    color: #1a1714;\n    font-weight: 500;\n  }\n\n  /* ── Section Headings ── */\n  .article-body h2 {\n    font-family: 'Rubik', serif;\n    font-size: clamp(20px, 3.5vw, 28px);\n    font-weight: 600;\n    color: #1a1714;\n    margin: 44px 0 16px;\n    padding-bottom: 10px;\n    border-bottom: 2px solid #f0ddd0;\n    line-height: 1.3;\n  }\n\n  .article-body h3 {\n    font-family: 'Playfair Display', serif;\n    font-size: clamp(17px, 2.5vw, 21px);\n    font-weight: 600;\n    color: #1a1714;\n    margin: 30px 0 12px;\n    line-height: 1.35;\n  }\n\n  /* ── Scheme Cards ── */\n  .scheme-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));\n    gap: 16px;\n    margin: 24px 0 32px;\n  }\n\n  .scheme-card {\n    background: #fff9f2;\n    border: 1px solid #e8e2da;\n    border-top: 3px solid #0d1282;\n    border-radius: 10px;\n    padding: 20px 18px;\n    transition: box-shadow .2s, transform .2s;\n  }\n  .scheme-card:hover { box-shadow: 0 6px 24px rgba(200,98,42,.12); transform: translateY(-2px); }\n\n  .scheme-card .scheme-num {\n    font-size: 11px;\n    font-weight: 500;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n    color: #0d1282;\n    margin-bottom: 8px;\n  }\n\n  .scheme-card h3 {\n    font-family: 'Playfair Display', serif;\n    font-size: 15px;\n    font-weight: 600;\n    color: #1a1714;\n    margin: 0 0 8px;\n    line-height: 1.3;\n  }\n\n  .scheme-card p {\n    font-size: 13.5px !important;\n    color: #1a1714 !important;\n    margin-bottom: 0 !important;\n    line-height: 1.5 !important;\n    font-weight: 300 !important;\n  }\n\n  /* ── Bullet lists ── */\n  .article-body ul {\n    padding-left: 0;\n    margin: 12px 0 22px;\n    list-style: none;\n  }\n\n  .article-body ul li {\n    font-size: 16px;\n    color: #1a1714;\n    font-weight: 300;\n    padding: 7px 0 7px 22px;\n    position: relative;\n    border-bottom: 1px solid #e8e2da;\n    line-height: 1.6;\n  }\n  .article-body ul li:last-child { border-bottom: none; }\n\n  .article-body ul li::before {\n    content: '→';\n    position: absolute;\n    left: 0;\n    color: #0d1282;\n    font-size: 13px;\n    top: 9px;\n  }\n\n  /* ── Key Dates Banner ── */\n  .dates-banner {\n    background: linear-gradient(135deg, #1a1714 0%, #2d2620 100%);\n    border-radius: 12px;\n    padding: 28px 28px;\n    margin: 30px 0;\n    display: flex;\n    gap: 24px;\n    flex-wrap: wrap;\n  }\n\n  .date-item {\n    flex: 1;\n    min-width: 160px;\n  }\n\n  .date-item .date-label {\n    font-size: 11px;\n    font-weight: 500;\n    letter-spacing: .1em;\n    text-transform: uppercase;\n    color: #d4a04a;\n    margin-bottom: 6px;\n  }\n\n  .date-item .date-val {\n    font-family: 'Rubik', serif;\n    font-size: 18px;\n    font-weight: 600;\n    color: #fff;\n    line-height: 1.2;\n  }\n\n  .date-item .date-sub {\n    font-size: 12px;\n    color: rgba(255,255,255,.45);\n    margin-top: 4px;\n    font-weight: 300;\n  }\n\n  /* ── Info Highlight Box ── */\n  .info-box {\n    background: #fdf6e7;\n    border: 1px solid #e8d49a;\n    border-left: 4px solid #d4a04a;\n    border-radius: 8px;\n    padding: 18px 20px;\n    margin: 24px 0;\n    font-size: 15px;\n    color: #1a1714;\n    font-weight: 300;\n    line-height: 1.6;\n  }\n\n  .info-box strong { color: #1a1714; font-weight: 500; }\n\n  /* ── Portal link box ── */\n  .portal-box {\n    background: var(--accent-pale);\n    border: 1px solid #e8c4a8;\n    border-radius: 10px;\n    padding: 20px 22px;\n    margin: 20px 0 28px;\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    flex-wrap: wrap;\n  }\n\n  .portal-box .portal-label {\n    font-size: 13px;\n    font-weight: 500;\n    letter-spacing: .06em;\n    text-transform: uppercase;\n    color: #0d1282;\n    margin-bottom: 4px;\n  }\n\n  .portal-box .portal-url {\n    font-family: 'Playfair Display', serif;\n    font-size: 18px;\n    font-weight: 600;\n    color: #1a1714;\n  }\n\n  .portal-box .portal-icon {\n    width: 44px;\n    height: 44px;\n    background: #0d1282;\n    border-radius: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n    color: #fff;\n    font-size: 20px;\n  }\n\n  /* ── Age criteria table ── */\n  .age-table {\n    width: 100%;\n    border-collapse: collapse;\n    margin: 16px 0 28px;\n    font-size: 15px;\n    border-radius: 10px;\n    overflow: hidden;\n    box-shadow: 0 0 0 1px #e8e2da;\n  }\n\n  .age-table thead tr {\n    background: #1a1714;\n    color: #fff;\n  }\n\n  .age-table th {\n    padding: 13px 16px;\n    text-align: left;\n    font-weight: 500;\n    font-size: 13px;\n    letter-spacing: .04em;\n  }\n\n  .age-table tbody tr {\n    border-bottom: 1px solid #e8e2da;\n    transition: background .15s;\n  }\n  .age-table tbody tr:hover { background: rgb(7, 6, 6); }\n  .age-table tbody tr:last-child { border-bottom: none; }\n\n  .age-table td {\n    padding: 13px 16px;\n    color: #1a1714;\n    font-weight: 300;\n  }\n\n  .age-table td:last-child {\n    font-weight: 500;\n    color: #0d1282;\n  }\n\n  /* ── Important notes ── */\n  .notes-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));\n    gap: 14px;\n    margin: 16px 0 28px;\n  }\n\n\n  .note-card {\n    background: #fff9f2;\n    border: 1px solid #e8e2da;\n    border-radius: 10px;\n    padding: 16px;\n    font-size: 14px;\n    color: #1a1714;\n    font-weight: 300;\n    line-height: 1.55;\n    display: flex;\n    gap: 10px;\n    align-items: flex-start;\n  }\n\n  .note-card .note-icon {\n    font-size: 16px;\n    flex-shrink: 0;\n    margin-top: 1px;\n  }\n\n  /* ── CTA ── */\n  .cta-block {\n    background: #0d1282;\n    border-radius: 14px;\n    padding: 36px 32px;\n    text-align: center;\n    margin: 44px 0 0;\n    color: #fff;\n  }\n\n  .cta-block h3 {\n    font-family: 'Playfair Display', serif;\n    font-size: 24px;\n    font-weight: 600;\n    margin-bottom: 10px;\n    color: #fff;\n  }\n\n  .cta-block p {\n    font-size: 15px;\n    color: rgba(255,255,255,.8);\n    margin-bottom: 22px;\n    font-weight: 300;\n  }\n\n  .cta-btn {\n    display: inline-block;\n    background: #fff;\n    color: #0d1282;\n    font-family: 'Rubik', sans-serif;\n    font-size: 14px;\n    font-weight: 500;\n    letter-spacing: .04em;\n    text-transform: uppercase;\n    padding: 13px 28px;\n    border-radius: 8px;\n    text-decoration: none;\n    transition: transform .2s, box-shadow .2s;\n    box-shadow: 0 4px 16px rgba(0,0,0,.15);\n  }\n  .cta-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,.2); }\n\n  /* ── Final thoughts pullquote ── */\n  .pullquote {\n    border-left: 3px solid #0d1282;\n    margin: 28px 0;\n    padding: 18px 24px;\n    background: rgb(7, 6, 6);\n    border-radius: 0 10px 10px 0;\n    font-family: 'Playfair Display', serif;\n    font-size: 18px;\n    font-style: italic;\n    color: #fff !important;\n    line-height: 1.55;\n  }\n\n  /* ── Reading progress bar ── */\n  #progress-bar {\n    position: fixed;\n    top: 0;\n    left: 0;\n    height: 3px;\n    background: linear-gradient(90deg, #0d1282, #d4a04a);\n    width: 0%;\n    z-index: 9999;\n    transition: width .1s linear;\n  }\n\n  /* ── Animations ── */\n  @keyframes fadeUp {\n    from { opacity: 0; transform: translateY(18px); }\n    to   { opacity: 1; transform: translateY(0); }\n  }\n\n  .article-title { animation: fadeUp .6s ease both; }\n  .hero-wrap { animation: fadeUp .6s .1s ease both; }\n  .article-body { animation: fadeUp .6s .2s ease both; }\n\n  /* ── Responsive ── */\n  @media (max-width: 600px) {\n    .page-wrapper { padding: 0 16px 60px; }\n    .meta-top { padding-top: 24px; }\n    .dates-banner { flex-direction: column; gap: 18px; padding: 22px 20px; }\n    .scheme-grid { grid-template-columns: 1fr; }\n    .notes-grid { grid-template-columns: 1fr; }\n    .cta-block { padding: 28px 20px; }\n    .portal-box { flex-direction: column; gap: 10px; }\n    .meta-date { margin-left: 0; }\n  }\n</style>\n\n<div id=\"progress-bar\"></div>\n\n<div class=\"page-wrapper\">\n\n \n\n  <!-- Title -->\n\n  \n\n  <!-- Body -->\n  <div class=\"article-body\">\n\n    <p>The <strong>Indian Council for Cultural Relations (ICCR)</strong> opened applications for the <strong>ICCR Scholarship 2026–27</strong> on February 27, 2026 and closed them on April 15, 2026. The scholarship is for Nepali students who wish to pursue higher education in India. Use this guide to prepare for the next round, and check the Embassy of India in Kathmandu for new dates. These scholarships provide an excellent opportunity for students to study at recognized Indian universities and institutions with financial support.</p>\n\n    <p>If you are planning to study in India with a scholarship, this guide explains the available schemes, eligibility, application process, and important deadlines.</p>\n\n    <hr class=\"rule\">\n\n    <h2>ICCR Scholarship Schemes for 2026–27</h2>\n    <p>The Embassy of India in Kathmandu invites applications from Nepali students under the following scholarship schemes:</p>\n\n    <div class=\"scheme-grid\">\n      <div class=\"scheme-card\">\n        <div class=\"scheme-num\">Scheme 01</div>\n        <h3>Atal Bihari Vajpayee General Scholarship Scheme</h3>\n        <p>Available for students pursuing <strong>Undergraduate programs</strong> in India.</p>\n      </div>\n      <div class=\"scheme-card\">\n        <div class=\"scheme-num\">Scheme 02</div>\n        <h3>Sushma Swaraj Silver Jubilee Scholarship Scheme</h3>\n        <p>Supports students pursuing <strong>Postgraduate and doctoral (PhD) programs</strong> at Indian universities.</p>\n      </div>\n      <div class=\"scheme-card\">\n        <div class=\"scheme-num\">Scheme 03</div>\n        <h3>Lata Mangeshkar Dance &amp; Music Scholarship Scheme</h3>\n        <p>Designed for students interested in <strong>Indian culture and performing arts</strong>.</p>\n      </div>\n    </div>\n\n    <p>Students applying under the Lata Mangeshkar scheme may be required to provide evidence of prior knowledge or experience. Eligible performing art disciplines include:</p>\n\n    <ul>\n      <li>Dance</li>\n      <li>Music</li>\n      <li>Theater</li>\n      <li>Sculpture</li>\n      <li>Indian languages</li>\n      <li>Yoga</li>\n      <li>Indian cuisine</li>\n    </ul>\n\n    <hr class=\"rule\">\n\n    <h2>Important Dates</h2>\n\n    <div class=\"dates-banner\">\n      <div class=\"date-item\">\n        <div class=\"date-label\">Portal Opens</div>\n        <div class=\"date-val\">February 27, 2026</div>\n        <div class=\"date-sub\">Applications accepted from this date</div>\n      </div>\n      <div class=\"date-item\">\n        <div class=\"date-label\">Application Deadline</div>\n        <div class=\"date-val\">April 15, 2026</div>\n        <div class=\"date-sub\">All documents must be submitted</div>\n      </div>\n    </div>\n\n    <p>Students are encouraged to apply early and carefully review all instructions before submitting the application.</p>\n\n    <hr class=\"rule\">\n\n    <h2>How to Apply for ICCR Scholarship</h2>\n\n    <p>Students must apply <strong>online through the ICCR A2A Scholarship Portal</strong>. Applicants should carefully read the guidelines and fill out the online application form with accurate information.</p>\n\n    <div class=\"portal-box\">\n      <div class=\"portal-icon\">🔗</div>\n      <div>\n        <div class=\"portal-label\">Application Portal</div>\n        <div class=\"portal-url\">www.a2ascholarships.iccr.gov.in</div>\n      </div>\n    </div>\n\n    <hr class=\"rule\">\n\n    <h2>Application Fee</h2>\n\n    <div class=\"info-box\">\n      <strong>NPR 400</strong> application fee must be deposited in favor of the <strong>Education Wing, Embassy of India, Kathmandu</strong> at any branch of <strong>Nepal SBI Bank</strong>. After depositing, write your online application registration number and name on the payment receipt, then submit the original receipt along with the printed application and documents to the relevant office.\n    </div>\n\n    <hr class=\"rule\">\n\n    <h2>Documents Required for Application</h2>\n    <p>Students should prepare the following documents before applying:</p>\n\n    <ul>\n      <li>Academic transcripts and certificates (Class 10 and 10+2 or higher)</li>\n      <li>Passport copy</li>\n      <li>Passport-size photograph</li>\n      <li>English translation of documents if the originals are not in English</li>\n      <li>A <strong>500-word essay in English</strong> on a topic provided on the portal</li>\n      <li>Proof of English proficiency or an undertaking from the last attended institution</li>\n    </ul>\n\n    <p>Students should ensure all documents are complete and properly uploaded, as incomplete applications may be rejected.</p>\n\n    <hr class=\"rule\">\n\n    <h2>Age Criteria</h2>\n    <p>Applicants must meet the following age requirements as of <strong>July 1, 2026</strong>:</p>\n\n    <table class=\"age-table\">\n      <thead>\n        <tr>\n          <th>Program Level</th>\n          <th>Min Age</th>\n          <th>Max Age</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td>Undergraduate</td>\n          <td>18 years</td>\n          <td>35 years</td>\n        </tr>\n        <tr>\n          <td>Postgraduate</td>\n          <td>18 years</td>\n          <td>35 years</td>\n        </tr>\n        <tr>\n          <td>PhD / Doctoral</td>\n          <td>18 years</td>\n          <td>40 years</td>\n        </tr>\n        <tr>\n          <td>Cultural courses</td>\n          <td>18 years</td>\n          <td>No upper limit*</td>\n        </tr>\n      </tbody>\n    </table>\n\n    <p style=\"font-size:13px; color: #1a1714\">*Some cultural courses may not have an upper age limit, depending on the institution.</p>\n\n    <hr class=\"rule\">\n\n    <h2>Important Notes for Applicants</h2>\n\n    <div class=\"notes-grid\">\n      <div class=\"note-card\">\n        <span class=\"note-icon\">🚫</span>\n        <span>Medical, paramedical, and integrated law courses are <strong>not covered</strong> under this scholarship.</span>\n      </div>\n      <div class=\"note-card\">\n        <span class=\"note-icon\">🔬</span>\n        <span>Students applying for science or engineering programs must have studied <strong>Physics, Chemistry, and Mathematics</strong> in high school.</span>\n      </div>\n      <div class=\"note-card\">\n        <span class=\"note-icon\">📊</span>\n        <span>For <strong>MBA programs</strong>, a <strong>GMAT score is mandatory</strong>.</span>\n      </div>\n      <div class=\"note-card\">\n        <span class=\"note-icon\">📄</span>\n        <span>Applications must include all required documents in <strong>English or with English translation</strong>.</span>\n      </div>\n    </div>\n\n    <hr class=\"rule\">\n\n    <h2>Final Thoughts</h2>\n\n    <div class=\"pullquote\">\n      The ICCR Scholarship is a valuable opportunity for Nepali students to pursue quality education in India across various academic and cultural fields.\n    </div>\n\n    <p>With proper preparation and timely application, students can benefit from this prestigious scholarship and gain international academic exposure.</p>\n\n    <p>If you are interested in applying for the ICCR Scholarship 2026–27, make sure to prepare your documents early and submit your application before the deadline. If you need any more guidelines, please connect with Team Admizz Education!</p>\n\n  </div><!-- /article-body -->\n\n  <!-- CTA -->\n  <div class=\"cta-block\">\n    <h3>Need Guidance for Studying Abroad?</h3>\n    <p>Admizz Education helps students explore global education opportunities and make informed decisions about their academic future.</p>\n    <a href=\"https://admizzeducation.com/register\" class=\"cta-btn\">Talk to a Counselor Today</a>\n  </div>\n\n</div><!-- /page-wrapper -->\n\n<script>\n  // Reading progress bar\n  const bar = document.getElementById('progress-bar');\n  window.addEventListener('scroll', () => {\n    const scrollTop = window.scrollY;\n    const docHeight = document.documentElement.scrollHeight - window.innerHeight;\n    bar.style.width = docHeight > 0 ? (scrollTop / docHeight * 100) + '%' : '0%';\n  });\n</script>\n"
    },
