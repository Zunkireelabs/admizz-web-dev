x;box-shadow:0 0 0 1px #e0dbd0}\n.elig-table{width:100%;min-width:500px;border-collapse:collapse;font-size:15px}\n.elig-table th{background:#0d1b2a;color:#fff;padding:11px 16px;text-align:left;font-weight:500;font-size:13px;letter-spacing:.04em}\n.elig-table td{padding:12px 16px;border-bottom:1px solid #e0dbd0;vertical-align:top;line-height:1.55}\n.elig-table tr:nth-child(even) td{background:#faf8f3}\n.elig-table td:first-child{font-weight:600;color:#0d1b2a}\n.timeline{margin:28px 0;position:relative;padding-left:26px}\n.timeline::before{content:'';position:absolute;left:7px;top:8px;bottom:8px;width:2px;background:#e0dbd0}\n.timeline-item{position:relative;margin-bottom:28px}\n.timeline-item::before{content:'';position:absolute;left:-22px;top:5px;width:13px;height:13px;border-radius:50%;background:#3C50A0;border:2px solid #faf8f3;box-shadow:0 0 0 1px #3C50A0}\n.timeline-date{font-size:11px;font-weight:700;color:#2A3D8F;text-transform:uppercase;letter-spacing:.08em;margin-bottom:3px}\n.timeline-event{font-size:15.5px;font-weight:600;color:#1a1a18;margin-bottom:4px}\n.timeline-note{font-size:14px;color:#4a4a46;line-height:1.6}\n.inline-cta{background:#EAF0FA;border:1.5px solid #3C50A0;border-radius:10px;padding:22px 28px;margin:36px 0;display:flex;align-items:center;gap:20px;flex-wrap:wrap}\n.inline-cta-text{flex:1;font-size:15px;color:#1e3a6a;line-height:1.55;min-width:200px}\n.inline-cta-text strong{display:block;font-size:15.5px;margin-bottom:4px;color:#0d1b2a}\n.inline-cta a{background:#0d1b2a;color:#fff;font-family:'Rubik',sans-serif;font-size:14px;font-weight:600;padding:10px 22px;border-radius:7px;text-decoration:none;white-space:nowrap}\n.inline-cta a:hover{background:#3C50A0}\n.cta-banner{background:linear-gradient(135deg,#0d1b2a 0%,#0d1282 100%);border-radius:16px;padding:48px 40px;margin:48px 0;text-align:center;position:relative;overflow:hidden}\n.cta-banner::before{content:'';position:absolute;top:-60px;right:-60px;width:200px;height:200px;border-radius:50%;background:#0d1282}\n.cta-banner::after{content:'';position:absolute;bottom:-80px;left:-40px;width:250px;height:250px;border-radius:50%;background:#0d1282}\n.cta-banner h2{font-size:clamp(19px,2.8vw,26px);font-weight:700;color:#fff;border:none;padding:0;margin-bottom:12px;position:relative;z-index:1}\n.cta-banner p{color:rgba(255,255,255,.72);font-size:16px;max-width:520px;margin:0 auto 28px;position:relative;z-index:1}\n.cta-btns{display:flex;flex-wrap:wrap;gap:14px;justify-content:center;position:relative;z-index:1}\n.btn-primary{background:#3C50A0;color:#fff;font-family:'Rubik',sans-serif;font-weight:600;font-size:15px;padding:13px 28px;border-radius:8px;text-decoration:none;display:inline-block}\n.btn-primary:hover{background:#2A3D8F}\n.btn-secondary{background:transparent;color:#fff;font-family:'Rubik',sans-serif;font-weight:600;font-size:15px;padding:12px 28px;border-radius:8px;text-decoration:none;display:inline-block;border:1.5px solid rgba(255,255,255,.35)}\n.faq-item{border-bottom:1px solid #e0dbd0;padding:20px 0}\n.faq-q{font-size:16.5px;font-weight:600;color:#0d1b2a;margin-bottom:10px}\n.faq-a{font-size:15.5px;color:#4a4a46;line-height:1.75}\n@media(max-width:600px){.facts-grid{grid-template-columns:1fr 1fr}.cta-banner{padding:36px 22px}.inline-cta{flex-direction:column}}\n</style>\n</head>\n<body>\n<div class=\"container\">\n<article>\n<div class=\"quick-facts\"><div class=\"quick-facts-title\">🎓 PhD in the UK — At a Glance</div><div class=\"facts-grid\"><div class=\"fact-item\"><span class=\"fact-label\">Duration</span><span class=\"fact-value\">3–4 Years (Full-Time, Typical)</span></div><div class=\"fact-item\"><span class=\"fact-label\">Fee Example</span><span class=\"fact-value\">£17,400 / Year (UEL, 2026/27)</span></div><div class=\"fact-item\"><span class=\"fact-label\">Lab Subjects</span><span class=\"fact-value\">Extra Bench Fees Up To £6,000</span></div><div class=\"fact-item\"><span class=\"fact-label\">Entry Requirement</span><span class=\"fact-value\">2:1 Bachelor's or Master's (Typical)</span></div><div class=\"fact-item\"><span class=\"fact-label\">Dependants</span><span class=\"fact-value\">Possible on Research Courses</span></div><div class=\"fact-item\"><span class=\"fact-label\">Funding</span><span class=\"fact-value\">Studentships, Scholarships, Self-Funding</span></div></div></div><section class=\"section\" id=\"s1\"><h2>How a UK PhD Works</h2><p>A UK PhD is built around one independent research project, usually completed in <strong>three to four years</strong> of full-time study under a supervisor. Unlike a US PhD, you normally apply with a clear research proposal and do not take many classes.</p><p>Most students apply to a specific project or supervisor, or submit their own proposal to a department. A good match between your idea and your supervisor's work matters a lot.</p></section><section class=\"section\" id=\"s2\"><h2>Fees and Funding</h2><p>Fees vary by university and subject. As an example, the University of East London lists <strong>£17,400 per year</strong> for a full-time MPhil/PhD in 2026/27, with lab-based programs adding bench fees of up to £6,000. Fees at research-intensive universities can be considerably higher, especially in science and engineering.</p><ul class=\"checklist\"><li><strong>University studentships:</strong> funded PhD places, often advertised for specific projects.</li><li><strong>Government and charity awards:</strong> such as Gates Cambridge, which covers full costs and a maintenance allowance.</li><li><strong>Research council funding:</strong> some UK research funding is open to international students at certain universities.</li><li><strong>Self-funding:</strong> possible, but plan for tuition plus living costs for several years.</li></ul><div class=\"inline-cta\"><div class=\"inline-cta-text\"><strong>Looking for a funded PhD?</strong>Admizz Education helps you search studentships and prepare your proposal.</div><a href=\"https://admizzeducation.com/register\" rel=\"noopener\">Get Free Guidance →</a></div></section><section class=\"section\" id=\"s5\"><h2>Published PhD Fees at Some Universities (2026/27)</h2><div class=\"table-scroll\"><table class=\"elig-table\"><thead><tr><th>University</th><th>Full-time research fee</th><th>Notes</th></tr></thead><tbody><tr><td>University of East London</td><td>£17,400 per year</td><td>Lab-based programs can add bench fees up to £6,000</td></tr><tr><td>Health Sciences University</td><td>£17,046 per year</td><td>Health and movement-related research</td></tr><tr><td>University of Winchester</td><td>£16,700 per year full-time; £8,350 part-time</td><td>MPhil/PhD</td></tr></tbody></table></div><p>Fees at research-intensive universities can be higher, and funding may be tied to a project. Confirm the current fee with the department.</p></section><section class=\"section\" id=\"s3\"><h2>Entry Requirements and Application</h2><ul class=\"checklist\"><li><strong>Academic:</strong> usually a first-class or 2:1 degree, and often a master's degree in a related subject.</li><li><strong>English:</strong> commonly IELTS 6.5 overall or equivalent.</li><li><strong>Research proposal:</strong> a clear question, method and timeline.</li><li><strong>References:</strong> academic referees who know your research potential.</li><li><strong>ATAS:</strong> some sensitive subjects need an Academic Technology Approval Scheme certificate before your visa.</li></ul><div class=\"callout tip\"><span class=\"callout-icon\">💡</span><div class=\"callout-body\"><strong>Contact supervisors first</strong>Send a short, polite email with your CV and a one-page idea. A named supervisor can strengthen your application.</div></div></section><section class=\"section\" id=\"s4\"><h2>Visa, Dependants and Work After a PhD</h2><p>PhD students apply for a Student visa and must show maintenance funds. The standard rate is £1,171/£1,529 per month now, rising to £1,203/£1,570 from 30 November 2026, for up to nine months, and the Immigration Health Surcharge is £776 per year.</p><p>Students on research-based postgraduate courses may be able to bring dependants, which most taught master's students cannot. After graduating, the general Graduate Route is 18 months for applications from 1 January 2027, so check the current length for doctoral graduates before you plan.</p></section><div class=\"cta-banner\"><h2>Plan Your PhD Journey in the UK</h2><p>Admizz Education supports you from proposal to visa.</p><div class=\"cta-btns\"><a href=\"https://admizzeducation.com/register\" class=\"btn-primary\" rel=\"noopener\">Book Free Consultation →</a><a href=\"https://admizzeducation.com/\" class=\"btn-secondary\" rel=\"noopener\">Explore UK Universities</a></div></div><section class=\"section\" id=\"faq\"><h2>Frequently Asked Questions</h2><div class=\"faq-item\"><div class=\"faq-q\">How long is a PhD in the UK?</div><div class=\"faq-a\">Usually three to four years full-time, plus a possible write-up period.</div></div><div class=\"faq-item\"><div class=\"faq-q\">Is a master's needed for a UK PhD?</div><div class=\"faq-a\">Often yes, but a strong bachelor's can be enough for some programs. Check each university.</div></div><div class=\"faq-item\"><div class=\"faq-q\">Can I work during my PhD?</div><div class=\"faq-a\">Student visa rules limit work hours. Many PhD students also do paid teaching or research.</div></div></section>\n</article>\n</div>\n</body>\n</html>"
