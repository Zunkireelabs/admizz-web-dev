    },
    {
      "_key": "54f019bc4910",
      "_type": "block",
      "children": [
        {
          "_key": "891ef23d3686",
          "_type": "span",
          "marks": [],
          "text": "The goal of MD115 is to make Australia’s education system "
        },
        {
          "_key": "701929396767",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "more sustainable and fair"
        },
        {
          "_key": "cc573bf7e547",
          "_type": "span",
          "marks": [],
          "text": "."
        },
        {
          "_key": "73a892f7656b",
          "_type": "span",
          "marks": [],
          "text": "\n"
        },
        {
          "_key": "9359fa82af9e",
          "_type": "span",
          "marks": [],
          "text": "Instead of limiting visas directly, the government will use "
        },
        {
          "_key": "8eaaeec8d212",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "processing speed"
        },
        {
          "_key": "cf6fdb435b7a",
          "_type": "span",
          "marks": [],
          "text": " as a “soft cap.”"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
