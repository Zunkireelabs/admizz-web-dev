      "_type": "block",
      "children": [
        {
          "_key": "b1563e3d1666",
          "_type": "span",
          "marks": [],
          "text": "Starting "
        },
        {
          "_key": "e9ed89c0f788",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "November 14, 2025"
