        {
          "_key": "59da8705a991",
          "_type": "span",
          "marks": [],
          "text": "Test Preparation Costs"
        }
      ],
      "markDefs": [],
      "style": "h4"
    },
    {
      "_key": "54e82258c924",
      "_type": "block",
      "children": [
        {
          "_key": "38daf1c6da77",
          "_type": "span",
          "marks": [],
          "text": "Most UK universities require English proficiency tests such as IELTS or TOEFL. The costs for these tests are:"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "a3b27d38193f",
      "_type": "block",
      "children": [
        {
          "_key": "743bb95a607a",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "IELTS:"
        },
        {
          "_key": "44732eb027f2",
          "_type": "span",
          "marks": [],
          "text": " £150 – £200"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "08819f545d6c",
      "_type": "block",
      "children": [
        {
          "_key": "7b429e2411b8",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "TOEFL:"
        },
        {
          "_key": "ea627af116cb",
          "_type": "span",
          "marks": [],
          "text": " £180 – £250"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "2e5937ac94d6",
      "_type": "block",
      "children": [
        {
          "_key": "a145810005fa",
          "_type": "span",
          "marks": [],
          "text": "Some programs may also require standardized tests like GMAT or GRE, depending on the course. For expert guidance on test preparation, check our "
