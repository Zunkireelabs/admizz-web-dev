          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Upload Documents:"
        },
        {
          "_key": "00f4f3d4dfc1",
          "_type": "span",
          "marks": [],
          "text": " Scan and upload your photograph, signature, and relevant academic documents as per the specified format."
