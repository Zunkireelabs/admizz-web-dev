      "children": [
        {
          "_key": "8f57dcc144d0",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Submit Application:"
        },
        {
          "_key": "45dcd1374000",
          "_type": "span",
          "marks": [],
          "text": " Ensure you submit your completed application form along with the uploaded documents and fee payment confirmation by July 7, 2024 (11.45 PM)."
