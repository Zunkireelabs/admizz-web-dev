      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "19f8bb384e66",
      "_type": "block",
      "children": [
        {
          "_key": "d4ee5d463d0c",
          "_type": "span",
          "marks": [],
          "text": "This scholarship offers placement opportunities in some of India’s premier universities. Here are two highlights to consider for your B.Tech and B.Pharmacy applications:"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "2f995f720794",
      "_type": "block",
      "children": [
        {
          "_key": "4c3132c0726c",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Kalinga Institute of Industrial Technology (KIIT), Bhubaneswar:"
        },
        {
          "_key": "6eb31ee6a2f4",
          "_type": "span",
          "marks": [],
          "text": " Renowned for its exceptional academic programs, world-class infrastructure, and strong industry collaborations, KIIT is a dream destination for engineering and pharmacy aspirants."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "d30503a3e241",
      "_type": "block",
      "children": [
        {
          "_key": "bba99c2ec254",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "RK University, Rajkot, Gujarat:"
        },
        {
          "_key": "545944103d28",
          "_type": "span",
          "marks": [],
          "text": " Known for its commitment to academic excellence and focus on practical learning, RK University provides a nurturing environment for students to excel in their chosen fields of engineering and pharmacy."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "77e123c36e3a",
      "_type": "block",
      "children": [
        {
          "_key": "61cdf6e7ae6b",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Admizz Education is proud to be an exclusive partner"
        },
        {
          "_key": "a85341571312",
          "_type": "span",
          "marks": [],
          "text": " with both KIIT and RK University, and we can provide you with valuable guidance for these universities if you secure the COMPEX Scholarship."
        }
