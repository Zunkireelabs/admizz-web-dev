      "children": [
        {
          "_key": "055cf2d96c21",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Pay Application Fee:"
        },
        {
          "_key": "87ec0ddba181",
          "_type": "span",
          "marks": [],
          "text": " Deposit NPR 400 at any branch of Nepal SBI Bank using the generated challan."
        }
      ],
      "level": 1,
      "listItem": "number",
      "markDefs": [],
      "style": "normal"
    },
