            "strong"
          ],
          "text": "Fill Out Application:"
        },
        {
          "_key": "489766660e8d",
          "_type": "span",
          "marks": [],
          "text": " Complete the online application form, providing accurate details about your academic qualifications, course preferences, and contact information."
        }
      ],
      "level": 1,
      "listItem": "number",
      "markDefs": [],
      "style": "normal"
    },
