          "_key": "ca2e7b61225d",
          "_type": "span",
          "marks": [],
          "text": "Top Study Destinations for Nepali Students"
        }
      ],
      "markDefs": [],
      "style": "h4"
    },
    {
      "_key": "469c031985da",
      "_type": "rawHtml",
      "html": "<table class=\"has-fixed-layout\"><thead><tr><th>Country</th><th>Highlights</th><th>Popular Courses</th></tr></thead><tbody><tr><td>Germany</td><td>Free or low tuition, high-quality education</td><td>Engineering, Business, IT, Medicine</td></tr><tr><td>Netherlands</td><td>English-taught programs, multicultural environment</td><td>Business, Arts, Social Sciences</td></tr><tr><td>Sweden</td><td>Innovation-focused, research opportunities</td><td>Engineering, Science, Technology</td></tr><tr><td>Finland</td><td>Affordable, student-friendly policies</td><td>Education, IT, Health Sciences</td></tr><tr><td>Ireland</td><td>English-speaking, strong post-study work options</td><td>Business, IT, Science</td></tr></tbody></table>"
