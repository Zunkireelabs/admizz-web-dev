    },
    {
      "_key": "daef9255fb49",
      "_type": "block",
      "children": [
        {
          "_key": "fa5253f3d608",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "How long does it take to get an I-20?"
        },
        {
          "_key": "ce2ee6ae54b3",
          "_type": "span",
          "marks": [],
          "text": " Processing times vary by school and time of year, typically from a few days to several weeks after you submit all required documents."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "9b754d124d1c",
      "_type": "block",
      "children": [
        {
          "_key": "0263b6b8614f",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Can I apply for a visa with a copy of my I-20?"
        },
        {
          "_key": "538d7e48394c",
          "_type": "span",
          "marks": [],
          "text": " While some consulates "
        },
        {
          "_key": "b616ebf7fc1f",
          "_type": "span",
          "marks": [
            "em"
          ],
          "text": "might"
        },
        {
          "_key": "275c3d58c43c",
          "_type": "span",
          "marks": [],
          "text": " accept a digital copy in rare cases, always strive to have the original physical Form I-20 for your visa interview."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "968d64c89321",
      "_type": "block",
      "children": [
        {
          "_key": "a10094ee0958",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "What if I lose my Form I-20?"
        },
        {
          "_key": "130208a4b926",
          "_type": "span",
          "marks": [],
          "text": " Contact your DSO immediately for a replacement. Do this before attempting to re-enter the U.S. if you are abroad."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "2c2b5623b450",
      "_type": "block",
      "children": [
        {
          "_key": "39752d6ce314",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Is an I-20 the same as a visa?"
        },
        {
          "_key": "8d94d515da3c",
          "_type": "span",
          "marks": [],
          "text": " No, the I-20 certifies your eligibility to study, while the visa allows you to request entry into the U.S."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "87424b8f6546",
      "_type": "block",
      "children": [
        {
          "_key": "3e0d4198e945",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Do my dependents need to pay the SEVIS fee?"
        },
        {
          "_key": "5663df0c65a1",
          "_type": "span",
          "marks": [],
          "text": " No, only the primary F-1 or M-1 student is required to pay the I-901 SEVIS fee."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
