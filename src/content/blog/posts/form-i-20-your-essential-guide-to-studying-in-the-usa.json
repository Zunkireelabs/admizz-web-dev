        {
          "_key": "6627757c38b6",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Extensions:"
        },
        {
          "_key": "7d80c2736e07",
          "_type": "span",
          "marks": [],
          "text": " If you need more time to complete your studies, your DSO can extend your I-20 before its expiration."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
