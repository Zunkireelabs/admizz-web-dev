          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Required Documents for Re-entry:"
        },
        {
          "_key": "35acbee332ac",
          "_type": "span",
          "marks": [],
          "text": " When re-entering the U.S., always carry:\n"
        },
        {
          "_key": "e95447e75a37",
          "_type": "span",
          "marks": [],
          "text": "\n"
        }
      ],
      "level": 1,
      "listItem": "bullet",
