      "_type": "block",
      "children": [
        {
          "_key": "b6f3092573bb",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Grace Period:"
        },
        {
          "_key": "208f0bfeaec8",
          "_type": "span",
          "marks": [],
          "text": " After program completion, F-1 students typically have a 60-day grace period to depart, transfer schools, or apply for Optional Practical Training (OPT). M-1 students have a 30-day grace period."
        }
      ],
      "level": 1,
      "listItem": "bullet",
