      "children": [
        {
          "_key": "af223f41fc34",
          "_type": "span",
          "marks": [],
          "text": "A valid passport (at least six months beyond your intended stay)."
        }
      ],
      "level": 2,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "97d03684b3ba",
      "_type": "block",
      "children": [
        {
          "_key": "7ae130980602",
          "_type": "span",
          "marks": [],
          "text": "A valid F-1 or M-1 visa stamp (Canadians are exempt from the visa stamp)."
        }
      ],
      "level": 2,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "1ffd9c0718c3",
      "_type": "block",
      "children": [
