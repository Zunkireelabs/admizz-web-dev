          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Program Completion Date:"
        },
        {
          "_key": "a2439e8219a0",
          "_type": "span",
          "marks": [],
          "text": " Your I-20 shows an estimated program end date. This is an estimate; your actual completion may vary."
