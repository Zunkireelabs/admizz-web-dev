        {
          "_key": "74c07abb7f81",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "UK Student Visa Checklist"
        },
        {
          "_key": "06625af106f9",
          "_type": "span",
          "marks": [],
          "text": ". This guide is designed to help you understand exactly what documents you need, how much funds to show, what English tests to take, and how to stay compliant with the newest UKVI (UK Visas and Immigration) rules."
        }
      ],
      "markDefs": [],
      "style": "normal"
