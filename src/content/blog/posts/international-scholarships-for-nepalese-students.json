      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "6c51fd9edbd1",
      "_type": "block",
      "children": [
        {
          "_key": "3af4cb34ecc9",
          "_type": "span",
          "marks": [],
          "text": "Boosted academic and professional credibility"
