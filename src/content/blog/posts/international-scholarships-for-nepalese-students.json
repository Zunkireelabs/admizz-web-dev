      "markDefs": [],
      "style": "h3"
    },
    {
      "_key": "6f440ff1bb27",
      "_type": "block",
      "children": [
        {
          "_key": "98ac032a4391",
          "_type": "span",
          "marks": [],
          "text": "International scholarships are available for a wide range of students from Nepal, regardless of their academic background or study level. While eligibility criteria vary by institution and program, common requirements include:"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
