      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "dddba1587794",
      "_type": "block",
      "children": [
        {
          "_key": "a7e036cbaddc",
          "_type": "span",
          "marks": [],
