      "_type": "block",
      "children": [
        {
          "_key": "cb5b33ecb875",
          "_type": "span",
          "marks": [],
          "text": "Types of Scholarships Available for Nepali Students"
        }
      ],
      "markDefs": [],
      "style": "h3"
    },
    {
      "_key": "ae0dab7d35b5",
      "_type": "block",
      "children": [
        {
          "_key": "ae91e5c055f5",
          "_type": "span",
          "marks": [],
          "text": "Fortunately, there are several scholarships that help reduce financial barriers:"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "45b0493992ca",
      "_type": "block",
      "children": [
        {
          "_key": "e9cebb026852",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Merit-based scholarships"
        },
        {
          "_key": "e471dca74164",
          "_type": "span",
          "marks": [],
          "text": " – awarded to students with excellent academic records."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "73eb993d27a2",
      "_type": "block",
      "children": [
        {
          "_key": "9bed312bed6b",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Need-based scholarships"
        },
        {
          "_key": "84dd847059b6",
          "_type": "span",
          "marks": [],
          "text": " – designed for students who require financial assistance."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "f2d62f4899e8",
      "_type": "block",
      "children": [
        {
          "_key": "bbcb20809507",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "University-specific scholarships"
        },
        {
          "_key": "e34ae0d394a0",
          "_type": "span",
          "marks": [],
          "text": " – many US universities provide partial or full tuition support for international students."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "3d3e4903824d",
      "_type": "block",
      "children": [
        {
          "_key": "b0de49f89f74",
          "_type": "span",
          "marks": [
            "strong"
          ],
          "text": "Government and private scholarships"
        },
        {
          "_key": "434014814203",
          "_type": "span",
          "marks": [],
          "text": " – programs like Fulbright and other foundations support talented students from Nepal."
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "ee1140b751de",
