      ],
      "markDefs": [],
      "style": "h3"
    },
    {
      "_key": "7e00a323fda4",
      "_type": "block",
      "children": [
        {
          "_key": "1cdcbc52056c",
          "_type": "span",
          "marks": [],
          "text": "To begin with, the USA consistently ranks among the top destinations for international students. It offers:"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b66510a4e0b6",
      "_type": "block",
      "children": [
        {
          "_key": "c96f0730494b",
          "_type": "span",
          "marks": [],
          "text": "Globally recognized degrees."
        }
      ],
      "level": 1,
      "listItem": "number",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "b76568866bf4",
      "_type": "block",
      "children": [
        {
          "_key": "60f786422d67",
          "_type": "span",
          "marks": [],
          "text": "Access to cutting-edge research and technology."
        }
      ],
      "level": 1,
      "listItem": "number",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "4a1741cc5a4e",
      "_type": "block",
      "children": [
        {
          "_key": "c2da9e91eeb2",
          "_type": "span",
          "marks": [],
          "text": "A multicultural environment that fosters global networking."
        }
      ],
      "level": 1,
      "listItem": "number",
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "5a89a22b56de",
      "_type": "block",
      "children": [
        {
          "_key": "df24f52ab7c0",
          "_type": "span",
          "marks": [],
          "text": "Flexible academic structures, allowing students to design their own study paths."
